@@ -0,0 +1,30 @@
+mod bindings {
+    use super::Component;
+    wit_bindgen::generate!({
+        world: "stream-lower-return",
+    });
+    export!(Component);
+}
+
+use bindings::exports::jco::test_components::stream_lower_return_test;
+use bindings::jco::test_components::stream_lower_return_host;
+
+struct Component;
+
+impl stream_lower_return_test::Guest for Component {
+    async fn read_host_stream(vals: Vec<u32>) -> Vec<u32> {
+        // Call an async import whose return value is a `stream<u32>`, then drain
+        // it. The transpiled glue must lower the host-provided stream exactly
+        // once; lowering it both inline and via the async task-return machinery
+        // locks the underlying ReadableStream (the "double lower" regression).
+        let mut rx = stream_lower_return_host::produce_stream(vals).await;
+        let mut out = Vec::new();
+        while let Some(v) = rx.next().await {
+            out.push(v);
+        }
+        out
+    }
+}
+
+// Stub only to ensure this works as a binary
+fn main() {}
