+
+    // Regression test for the stream "double lower" bug: an async *import* whose
+    // return value is a `stream<T>` was lowered twice -- once by the inline
+    // lowering emitted for the call results, and once again by the async
+    // task-return machinery. The second lowering re-acquired a reader on an
+    // already-locked ReadableStream, producing
+    //   TypeError [ERR_INVALID_STATE]: Invalid state: ReadableStream is locked
+    // (or a hang, since the error was swallowed). The guest drains the imported
+    // stream and returns its values, so a double-lowered return value either
+    // throws or stalls here instead of round-tripping.
+    //
+    // See examples/apps/browser-tgz-maker for the original reproduction.
+    test("async import returning a stream is lowered exactly once", async () => {
+        const vals = [1, 2, 3, 4, 5];
+
+        const { instance, cleanup } = await setupAsyncTest({
+            asyncMode: "jspi",
+            component: {
+                path: join(LOCAL_TEST_COMPONENTS_DIR, "stream-lower-return.wasm"),
+                imports: {
+                    ...new WASIShim().getImportObject(),
+                    "jco:test-components/stream-lower-return-host": {
+                        // Async import whose return value is a stream. Returning
+                        // a ReadableStream here must be lowered exactly once.
+                        produceStream: async (requested) =>
+                            createReadableStreamFromValues([...requested]),
+                    },
+                },
+            },
+        });
+
+        try {
+            assert.deepEqual(
+                await instance["jco:test-components/stream-lower-return-test"].readHostStream(vals),
+                toTypedArray(Uint32Array, vals),
+            );
+        } finally {
+            await cleanup();
+        }
+    });
 });
