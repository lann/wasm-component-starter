     export local-run-async;
+}
+
+// Regression coverage for the stream "double lower" bug.
+//
+// An async *import* whose return value is a `stream<T>` had that returned
+// stream lowered twice: once by the inline lowering emitted for the call's
+// results, and once again by the async task-return machinery. The second
+// lowering tried to re-acquire a reader on a `ReadableStream` that was already
+// locked, surfacing as:
+//
+//   TypeError [ERR_INVALID_STATE]: Invalid state: ReadableStream is locked
+//
+// (or a hang, since the error was swallowed). The guest below calls such an
+// import and drains the returned stream, so transpiled glue that double-lowers
+// the import's return value fails this fixture.
+//
+// See examples/apps/browser-tgz-maker for the original reproduction.
+interface stream-lower-return-host {
+  produce-stream: async func(vals: list<u32>) -> stream<u32>;
+}
+
+interface stream-lower-return-test {
+  read-host-stream: async func(vals: list<u32>) -> list<u32>;
+}
+
+world stream-lower-return {
+  import stream-lower-return-host;
+  export stream-lower-return-test;
 }
\ No newline at end of file
