# Show the available recipes.
default:
    @just --justfile {{justfile()}} --list

# Build both components and compose them into build/app.wasm.
build: compose

# Python -> component via componentize-py.
metadata-parser:
    mkdir -p build
    componentize-py \
      -d wit -w metadata-parser \
      componentize -p metadata-parser app -o build/metadata-parser.wasm

# Rust -> wasm32-wasip2 component (the wasip2 linker componentizes the cdylib).
cli-app:
    cd cli-app && cargo build --release
    mkdir -p build
    cp cli-app/target/wasm32-wasip2/release/cli_app.wasm build/cli-app.wasm

# Plug the metadata-parser's exports into the cli-app's imports.
compose: cli-app metadata-parser
    cd build && wac plug cli-app.wasm --plug metadata-parser.wasm -o app.wasm

# Build then run with the given arguments.
run +ARGS: build
    wasmtime run -W component-model-async=y -S p3 -S http -S inherit-network --dir . build/app.wasm {{ARGS}}

# Build then run with the sample input
run-sample: (run "testdata/sample.html")

# test: run against the sample document and assert key metadata is extracted.
test: build
    #!/usr/bin/env bash
    set -euo pipefail
    output=$(just --justfile {{justfile()}} run-sample)
    echo "$output"
    for expected in \
        "title                  Widgets, Gadgets & Gizmos — Acme Corp" \
        "lang                   en" \
        "charset                utf-8" \
        "link:canonical         https://example.com/products" \
        "h1                     Everything you need, and a few things you don't"; do
        if ! grep -qF "$expected" <<<"$output"; then
            echo "FAIL: expected line not found: $expected" >&2
            exit 1
        fi
    done
    echo "PASS: all expected metadata present"

# Remove build artifacts.
clean:
    rm -rf build cli-app/target
