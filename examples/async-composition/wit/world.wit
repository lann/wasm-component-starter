package example:async-composition@0.1.0;

/// The contract between the two components in this example.
interface extractor {
    /// Consume an HTML document -- streamed in as UTF-8 bytes -- and produce
    /// page metadata as `(key, value)` pairs as they are discovered.
    extract: async func(html: stream<u8>) -> stream<tuple<string, string>>;
}

/// The `metadata-parser` component: a pure metadata extractor with no system
/// access.
///
/// It only `export`s `extractor`; it imports nothing, so it cannot touch the
/// filesystem, network, clock, or environment. All of its I/O happens through
/// the streams defined above.
world metadata-parser {
    export extractor;
}

/// The `cli-app` component: a CLI that resolves its input (a local file path or
/// an `http`/`https` URL), streams the bytes to the `metadata-parser`
/// component, and formats the metadata it gets back. URL fetching uses
/// `wasi:http` via the `wasip3` crate, so it is not declared here.
world cli-app {
    import extractor;
}
