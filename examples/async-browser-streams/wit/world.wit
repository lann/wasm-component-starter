package example:async-browser-streams@0.1.0;

/// Streaming compression, *provided by the host*.
///
/// A WebAssembly component cannot reach the Web platform itself, so it cannot
/// call the browser's `CompressionStream`. Instead it declares this dependency
/// and lets the JavaScript host satisfy it -- here, with a tiny adapter around
/// `new CompressionStream('gzip')`. From the component's point of view, gzip is
/// just another async streaming function it can call.
interface compressor {
    /// gzip-compress `data`, streaming. The result is the gzip-framed form of
    /// the input bytes; neither side is ever fully buffered.
    compress: async func(data: stream<u8>) -> stream<u8>;
}

/// A streaming `tar.gz` archiver, designed to be driven from JavaScript in the
/// browser via `jco` (JSPI) so that large files can be archived without ever
/// holding a whole file -- or the whole archive -- in memory.
interface archiver {
    /// One member of the archive.
    ///
    /// `size` is known up front (the browser reads it from each `File` object),
    /// which is the trick that makes true streaming possible: a tar `ustar`
    /// header records the file length *before* the bytes, so the header can be
    /// emitted immediately and the content streamed straight through.
    record entry {
        /// Archive member path, e.g. `docs/readme.txt`.
        name: string,
        /// Exact byte length of this member's contents.
        size: u64,
    }

    /// Build a gzipped tar archive (`tar.gz`).
    ///
    /// `entries` lists the members in order; `contents` carries every member's
    /// bytes concatenated in that same order. Internally the component encodes a
    /// `tar` stream and pipes it through the imported [`compressor`] (the host's
    /// `CompressionStream`); the returned stream is the gzip-compressed archive,
    /// identical to what `tar czf` would produce. Because each member's size is
    /// known ahead of time, bytes flow input -> tar -> gzip -> output a chunk at
    /// a time, and nothing is buffered whole.
    archive: async func(entries: list<entry>, contents: stream<u8>) -> stream<u8>;
}

/// The archiver component. It imports `compressor` (satisfied by the host's
/// `CompressionStream`) and exports `archiver`. The gzip step lives outside the
/// component precisely so this example can demonstrate an async, streaming
/// *import* across the JavaScript boundary.
world archiver-component {
    import compressor;
    export archiver;
}
