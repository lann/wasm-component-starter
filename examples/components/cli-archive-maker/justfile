# Build the `cli-archive-maker` component.
#
# A `wasm32-wasip2` `cdylib` that exports an *async* `wasi:cli/run` (via the
# `wasip3` crate) and imports the `archiver` interface. The `wasm32-wasip2`
# linker auto-componentizes the cdylib, so there is no `wasm-tools component
# new` step. The result still has an unsatisfied `archiver` import; the
# `cli-tgz-maker` app composes it with the `tar-archiver` and `gzip-compressor`
# components.

# Show the available recipes.
default:
    @just --justfile {{justfile()}} --list

# Rust -> wasm32-wasip2 component (archiver import left unsatisfied).
build:
    cargo build --release
    mkdir -p build
    cp target/wasm32-wasip2/release/cli_archive_maker.wasm \
       build/cli-archive-maker.component.wasm

# Remove build artifacts.
clean:
    rm -rf build target
