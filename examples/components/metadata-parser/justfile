# Build the `metadata-parser` component.
#
# `componentize-py` compiles `app.py` (and the Python runtime it needs) into a
# component that exports the `extractor` interface from the shared
# `example:html-metadata` WIT package. The component imports nothing.

# Show the available recipes.
default:
    @just --justfile {{justfile()}} --list

# Python -> component via componentize-py.
build:
    mkdir -p build
    componentize-py \
      -d ../../wit/html-metadata -w metadata-parser \
      componentize -p . app -o build/metadata-parser.component.wasm

# Remove build artifacts.
clean:
    rm -rf build __pycache__
