{
  "name": "wasm-component-model",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  // Toolchains come from the official dev container Features rather than a
  // custom Dockerfile. The Rust feature installs rustup + cargo and adds the
  // wasm targets; Node 24 ships JSPI natively (no flag required), which jco
  // relies on for async component transpilation; Python backs componentize-py.
  // The component-model CLIs themselves are installed with cargo-binstall in
  // the post-create hook (see post-create.sh).
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/rust:1": {
      "targets": "wasm32-wasip2,wasm32-unknown-unknown"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": false
    }
  },

  // Persist the cargo registry cache and build artifacts in named volumes.
  // Keeping `target` off the (slow, on macOS/Windows) workspace bind mount is
  // a meaningful build-speed win; the registry cache survives rebuilds. The
  // Rust feature sets CARGO_HOME=/usr/local/cargo, so the registry lives there.
  "mounts": [
    "source=wasm-component-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=wasm-component-target,target=${containerWorkspaceFolder}/target,type=volume"
  ],

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "bytecodealliance.wit-idl"
      ]
    }
  }
}
