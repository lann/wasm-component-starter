{
  "name": "wasm-component-model",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // Node 26 ships JSPI natively (no flag required), which jco relies on for
  // async component transpilation. The Node feature is layered on top of the
  // image, so jco itself is installed in post-create once node is on PATH.
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "26"
    }
  },

  // Persist the cargo registry cache and build artifacts in named volumes.
  // Keeping `target` off the (slow, on macOS/Windows) workspace bind mount is
  // a meaningful build-speed win; the registry cache survives rebuilds.
  "mounts": [
    "source=wasm-component-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=wasm-component-target,target=${containerWorkspaceFolder}/target,type=volume"
  ],

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "bytecodealliance.wit-idl"
      ]
    }
  }
}
